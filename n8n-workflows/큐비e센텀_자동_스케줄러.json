      "typeVersion": 2.3,
      "position": [1200, 100],
      "id": "if-new-post-qube",
      "name": "If (새 게시글이면)"
    },
    {
      "parameters": {
        "jsCode": "// HTML에서 테이블 데이터 파싱\nconst html = $input.first().json.html;\nconst trRegex = /<tr class=\"se-tr\">([\\s\\S]*?)<\\/tr>/g;\nconst rows = [];\nlet match;\n\nwhile ((match = trRegex.exec(html)) !== null) {\n  const tdContent = match[1].match(/<span[^>]*><b>([\\s\\S]*?)<\\/b><\\/span>/g);\n  if (tdContent) {\n    const cleanCells = tdContent.map(td => td.replace(/<[^>]*>/g, '').trim());\n    rows.push(cleanCells);\n  }\n}\n\n// 요일별 데이터 매핑\nconst days = [\"월\", \"화\", \"수\", \"목\", \"금\"];\nconst weeklyMenu = {};\n\nif (rows.length > 0) {\n  days.forEach((day, index) => {\n    weeklyMenu[day] = {\n      date: rows[0][index] || \"날짜정보 없음\",\n      menuItems: rows.slice(1).map(row => row[index]).filter(item => item && item !== \"​\")\n    };\n  });\n}\n\nreturn {\n  json: {\n    title: \"큐비e센텀 이번주 식단\",\n    current_title: $input.first().json.current_title,\n    weeklyMenu: weeklyMenu\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 100],
      "id": "parse-menu-qube",
      "name": "메뉴 데이터 파싱"
    },
    {
