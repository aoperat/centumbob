      "id": "fetch-blog-qube",
      "name": "블로그 페이지 가져오기"
    },
    {
      "parameters": {
        "jsCode": "// 프레임셋 HTML에서 본문 주소 추출\nconst html = $input.first().json.data;\nconst match = html.match(/id=\"mainFrame\"[^>]*src=\"([^\"]+)\"/);\n\nif (!match) {\n  throw new Error(\"본문 프레임 주소를 찾을 수 없습니다.\");\n}\n\nconst relativeUrl = match[1].replace(/&amp;/g, '&');\n\nreturn {\n  json: {\n    contentUrl: `https://m.blog.naver.com${relativeUrl.startsWith('/') ? relativeUrl : '/' + relativeUrl}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0],
      "id": "extract-frame-url-qube",
      "name": "본문 URL 추출"
    },
    {
      "parameters": {
        "url": "={{ $json.contentUrl }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [600, 0],
      "id": "fetch-content-qube",
      "name": "본문 HTML 가져오기"
    },
    {
      "parameters": {
        "jsCode": "// HTML에서 게시글 제목 추출\nconst html = $input.first().json.data;\nconst titleMatch = html.match(/<meta property=\"og:title\" content=\"([^\"]+)\"/);\nconst currentTitle = titleMatch ? titleMatch[1] : \"제목 없음\";\n\nreturn {\n  json: {\n    html: html,\n    current_title: currentTitle\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 0],
      "id": "extract-title-qube",
      "name": "게시글 제목 추출"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [800, 100],
      "id": "merge-title-qube",
      "name": "Merge (제목 비교)"
    },
